   "title": "Any document → text",
   "blob": "https://github.com/apache/tika/blob/{commit}/{treepath}",
   "timeout": 180,
   "per_ext": true,
   "mem_mb": 6000,
   "question": "Which Python tool turns the most kinds of documents into text for AI (RAG)?"
  },
  "ocr": {
   "corpus": "ocr",
   "ext": "jpg,png",
   "title": "OCR (image → text)",
   "blob": "https://github.com/prometheus-maker/ocr-testset/blob/{commit}/{path}",
   "scored": true,
   "timeout": 120,
   "mem_mb": 4000,
   "question": "Which Python OCR engine reads the most words correctly?",
   "lead": "real-world images with known text: 80 receipt photos, 50 document pages and 60 app screenshots",
   "noun": "images",
   "vs_question": "which OCR engine reads more words correctly?",
   "warmup": "board/warmup.png"
  },
  "speech": {
   "corpus": "speech",
   "ext": "wav",
   "title": "Speech to text (English)",
   "blob": "https://github.com/prometheus-maker/speech-testset/blob/{commit}/{path}",
   "scored": true,
   "timeout": 300,
   "mem_mb": 6000,
   "noun": "clips",
   "warmup": "board/warmup-speech.wav",
   "question": "Which offline speech-to-text engine for Python makes the fewest mistakes?",
   "vs_question": "which one makes fewer word errors?",
   "lead": "English clips with reference transcripts: audiobooks, read sentences, meetings (headset and table microphone) and earnings calls, 14.9 minutes",
   "score": {
    "key": "wer",
    "lower": true,
    "th": "✅ Word error<br>rate",
    "card": "Fewer word errors",
    "won": "made fewer word errors",
    "what": "word error rate {v}",
    "head": "word error rate"
   }
  }
 },
