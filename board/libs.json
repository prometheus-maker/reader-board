{
 "corpora": {
  "pdfjs": {
   "commit": "50d130738a150d43669c9554909020661ded5997",
   "title": "Mozilla pdf.js test PDFs",
   "repo": "mozilla/pdf.js"
  },
  "poi": {
   "commit": "39edce935ef8ed746b4457062ecfa2670eabe49f",
   "title": "Apache POI test files",
   "repo": "apache/poi"
  },
  "tika": {
   "commit": "52aaa53b3ff94677757ff326b669f05c57357240",
   "title": "Apache Tika test documents",
   "repo": "apache/tika"
  }
 },
 "formats": {
  "pdf": {
   "corpus": "pdfjs",
   "ext": "pdf",
   "blob": "https://github.com/mozilla/pdf.js/blob/{commit}/test/pdfs/{path}",
   "title": "PDF"
  },
  "docx": {
   "corpus": "poi",
   "ext": "docx",
   "blob": "https://github.com/apache/poi/blob/{commit}/test-data/document/{path}",
   "title": "Word (.docx)"
  },
  "xlsx": {
   "corpus": "poi",
   "ext": "xlsx",
   "blob": "https://github.com/apache/poi/blob/{commit}/test-data/spreadsheet/{path}",
   "title": "Excel (.xlsx)"
  },
  "pptx": {
   "corpus": "poi",
   "ext": "pptx",
   "blob": "https://github.com/apache/poi/blob/{commit}/test-data/slideshow/{path}",
   "title": "PowerPoint (.pptx)"
  },
  "docs": {
   "corpus": "tika",
   "ext": "pdf,docx,doc,rtf,odt,html,htm,xhtml,xlsx,xls,ods,pptx,ppt,odp,eml,msg,epub,txt,csv,md,json",
   "title": "Any document → text",
   "blob": "https://github.com/apache/tika/blob/{commit}/{treepath}",
   "timeout": 180,
   "per_ext": true,
   "mem_mb": 6000,
   "question": "Which Python tool turns any document into text for AI (RAG) with the fewest failures?"
  }
 },
 "libs": [
