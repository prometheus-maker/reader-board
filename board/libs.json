   "jobs": 2,
   "apt": "libmagic1 poppler-utils tesseract-ocr libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress pandoc",
   "unsupported": "(?i)UnsupportedFileFormatError|is not supported|Invalid file"
  },
  {
   "id": "Kreuzberg",
   "fmt": "docs",
